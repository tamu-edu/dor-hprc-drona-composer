    "bootstrap": "^5.3.3",
    "react": "^18.2.0",
    "react-data-table-component": "^7.6.2",
    "react-dom": "^18.2.0",
    "react-select": "^5.8.0",
    "socket.io-client": "^4.8.1",
    "styled-components": "^6.1.15"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.26.0",
    "@babel/preset-react": "^7.29.7",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "babel-jest": "^30.5.1",
    "babel-loader": "^9.2.1",
    "babel-plugin-transform-react-remove-prop-types": "^0.4.24",
    "baseline-browser-mapping": "^2.9.19",
    "compression-webpack-plugin": "^12.0.0",
    "core-js": "^3.40.0",
    "css-loader": "^7.1.2",
    "doctrine": "^3.0.0",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.5.1",
    "jest-environment-jsdom": "^30.5.1",
    "js-yaml": "^3.14.1",
    "jsdoc": "^4.0.4",
    "jsdoc-to-markdown": "^9.1.1",
    "style-loader": "^4.0.0",
    "terser-webpack-plugin": "^5.3.11",
    "webpack": "^5.101.3",
    "webpack-bundle-analyzer": "^4.10.2",
    "webpack-cli": "^6.0.1",
    "yaml-loader": "^0.8.1"
  },
  "scripts": {
    "demo": "node scripts/generate-demo-env.js",
    "docs": "jsdoc -r -d docs src",
    "docs:markdown": "jsdoc2md \"src/**/*.js\" > API.md",
    "docs:serve": "cd docs && python3 -m http.server 8080",
    "docs:deploy": "npm run docs",
    "build": "webpack --config webpack.config.js --mode=development",
    "build:prod": "webpack --config webpack.config.js --mode=production",
    "docs:docusaurus": "cd website && npm start -- --host 0.0.0.0",
    "docs:docusaurus:build": "cd website && npm run build",
    "build:prod:compress": "webpack --mode=production --env compress",
    "build-watch": "webpack --config webpack.config.js --mode=development --watch",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "bundle-report": "webpack-bundle-analyzer --port 5000 static/dist/stats.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tamu-edu/dor-hprc-drona-composer"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "sideEffects": [
    "./src/styles/JobComposerEnvSplitStyles.js"
  ],
  "browserslist": [
    "last 2 Chrome versions",
    "last 2 Firefox versions",
    "last 2 Safari versions",
    "last 2 Edge versions",
    "not dead"
  ],
  "bugs": {
