{
  "name": "drona_composer",
  "version": "1.0.0",
  "description": "Tool to create and submit batch jobs",
  "main": "webpack.config.js",
  "dependencies": {
    "@codemirror/lang-json": "^6.0.1",
    "@codemirror/lang-markdown": "^6.3.2",
