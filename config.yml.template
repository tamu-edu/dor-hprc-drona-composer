development: &common_settings
  cluster_name: "[cluster-name]"  # display name; lowercased it also selects runtime_support/schedulers/slurm/clusters/<name>.py
  scheduler: "slurm"  # selects runtime_support/schedulers/<name>/ (job states, cancel, scheduler retrievers)
  dashboard_url: "/pun/dev/[app-name]"
  file_app_url: "/pun/sys/files/fs"
  file_editor_url: "/pun/sys/file-editor/edit"
  home_page: "https://hprc.tamu.edu"
  driver_scripts_path: "/var/www/ood/apps/dev/[user-name]/gateway/[app-name]/machine_driver_scripts"
  env_repo_github: "https://github.com/tamu-edu/dor-hprc-drona-environments.git"
  retriever_timeout: 10  # seconds before a retriever script is killed (HTTP 504)
  env_import_enabled: true  # false: hide Import; users can't import environments from env_repo_github
  env_repo_ref: "drona-v2"  # branch of env_repo_github to import from; falls back to main if missing

production:
  <<: *common_settings
  dashboard_url: "/pun/sys/[app-name]"
  driver_scripts_path: "/var/www/ood/apps/sys/[app-name]/machine_driver_scripts"
  env_repo_github: "https://github.com/tamu-edu/dor-hprc-drona-environments.git"


local:
  cluster_name: "Local"
  dashboard_url: "http://localhost:5000"
  file_app_url: ""
  file_editor_url: ""
  home_page: ""
  driver_scripts_path: "./machine_driver_scripts"
  env_repo_github: "https://github.com/tamu-edu/dor-hprc-drona-environments.git"
  retriever_timeout: 10
  env_import_enabled: true
