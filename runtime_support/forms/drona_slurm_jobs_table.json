{
  "drona_slurmJobsTable": {
    "type": "container",
    "condition": "!drona_info_jobs.",
    "elements": {
      "drona_slurm_jobs_table": {
        "type": "staticText",
        "useLabel": false,
        "name": "drona_slurm_jobs_table",
        "isDynamic": true,
        "allowHtml": true,
        "refreshInterval": "10",
        "showRefreshButton": true,
        "retrieverParams": {
          "JOBS": "$drona_info_jobs"
        },
        "retriever": "drona_slurm_jobs_table.sh",
        "layout": { "preset": "card", "title": "Slurm Jobs (table)" }
      }
    }
  }
}
