{
  "drona_slurmPanel": {
    "type": "container",
    "condition": "!drona_info_jobs.",
    "layout": { "preset": "card", "title": "Slurm Panel" },
    "elements": {
      "drona_slurm_summary": {
        "type": "staticText",
        "useLabel": false,
        "name": "drona_slurm_jobs_panel",
        "isDynamic": true,
        "allowHtml": true,
        "showRefreshButton": true,
        "retrieverParams": {
          "JOBS": "$drona_info_jobs"
        },
        "retriever": "drona_slurm_jobs.sh",
        "layout": { "preset": "boxed", "title": "Slurm Jobs" }
      },
      "drona_cancel_jobs": {
        "type": "dynamicCheckboxGroup",
        "name": "drona_cancel_jobs",
        "useLabel": false,
        "condition": "!drona_status.DONE",
        "pruneMissing": true,
        "style": "toggle",
        "layout": [
          { "preset": "boxed", "title": "Slurm Actions" },
          "list",
          { "maxHeight": "220px", "overflowY": "auto" }
        ],
        "retrieverParams": {
          "JOBS": "$drona_info_jobs"
        },
        "retriever": "drona_cancelable_jobs.sh"
      }
    }
  }
}
