{
  "drona_slurmUtilizationPanel": {
    "type": "collapsibleColContainer",
    "title": "SLURM JOB UTILIZATION",
    "default_state": "collapsed",
    "condition": "!drona_create_manage_allworkflows. && !drona_status. && !drona_info_jobs. && (drona_status.RUNNING || drona_status.DONE)",
    "layout": { "preset": "card", "title": "SLURM JOB UTILIZATION" },
    "elements": {
      "drona_sstat_usage": {
        "type": "staticText",
        "name": "drona_sstat2",
        "useLabel": false,
        "condition": "drona_status.RUNNING",
        "isDynamic": true,
        "refreshInterval": "60",
        "showRefreshButton": true,
        "allowHtml": true,
        "retrieverParams": {
          "JOBID": "$drona_info_jobs",
          "NODE": "$drona_node"
        },
        "retriever": "drona_slurm_sstat.sh",
        "layout": { "preset": "boxed", "title": "Resource Usage · Job $drona_info_jobs" }
      },
      "drona_seff_usage": {
        "type": "staticText",
        "name": "drona_seffsummary",
        "useLabel": false,
        "condition": "drona_status.DONE",
        "isDynamic": true,
        "showRefreshButton": false,
        "allowHtml": true,
        "retrieverParams": {
          "JOBIDS": "$drona_info_jobs"
        },
        "retriever": "drona_slurm_seff.sh",
        "layout": { "preset": "boxed", "title": "Job Efficiency (seff)" }
      }
    }
  }
}
