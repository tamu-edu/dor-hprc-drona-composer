{
  "drona_logCollapse": {
    "type": "collapsibleRowContainer",
    "title": "Output/Error logs",
    "condition": " !jobs.",
    "default_state": "collapsed",
    "elements": {
      "drona_row_section": {
        "type": "rowContainer",
        "elements": {
          "drona_log_tabs": {
            "type": "staticText",
            "name": "drona_logname",
            "label": "",
            "isDynamic": true,
            "retrieverParams": {
              "WORKFLOW_ID": "$allworkflows"
            },
            "retriever": "drona_slurm_logs.sh",
            "refreshInterval": "70",
            "refreshWhile": "!drona_status.DONE",
            "showRefreshButton": true,
            "allowHtml": true
          }
        }
      }
    }
  }
}
