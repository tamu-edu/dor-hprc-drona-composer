{
  "drona_logCollapse": {
    "type": "container",
    "condition": "!drona_info_jobs.",
    "elements": {
      "drona_log_tabs": {
        "type": "staticText",
        "name": "drona_logname",
        "label": "",
        "isDynamic": true,
        "retrieverParams": {
          "WORKFLOW_ID": "$drona_create_manage_allworkflows",
          "SELECTED_JOBID": "$drona_job_scope",
          "LINES": "10",
          "VISIBLE_LINES": "15"
        },
        "retriever": "drona_slurm_logs.sh",
        "refreshInterval": "70",
        "refreshWhile": "!drona_status.DONE",
        "showRefreshButton": true,
        "allowHtml": true,
        "layout": { "preset": "card", "title": "Job Logs · Job $drona_job_scope", "dot": false, "collapsible": true }
      }
    }
  }
}
