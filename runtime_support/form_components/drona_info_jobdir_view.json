{
  "drona_workingDirectory": {
    "type": "rowContainer",
    "condition": "!jobs.",
    "elements": {
      "drona_jobDirLabel": {
        "type": "staticText",
        "useLabel": false,
        "name": "drona_job_dir_html",
        "isDynamic": true,
        "allowHtml": true,
        "condition": "!drona_job_dir.",
        "retrieverParams": {
          "JOB_DIR": "$drona_job_dir"
        },
        "retriever": "drona_info_jobdir_html.sh",
        "layout": { "preset": "card", "title": "Workflow Directory" }
      }
    }
  }
}
