{
  "drona_utilization_detail_section": {
    "type": "collapsibleRowContainer",
    "condition": "!drona_create_manage_allworkflows. &&  !drona_status. && drona_status.RUNNING && !drona_info_jobs. ",
    "title": "RESOURCE UTILIZATION",
    "elements": {
      "drona_nodeSelect": {
        "type": "dynamicSelect",
        "label": "pick node to inspect",
        "name": "drona_node",
        "retriever": "drona_select_nodes.sh",
        "retrieverParams": {
          "JOBID": "$drona_info_jobs"
        }
      },
      "drona_top_table": {
        "type": "staticText",
        "name": "drona_toptable",
        "condition": "!drona_node.",
        "label": "",
        "isDynamic": true,
        "retrieverParams": {
          "JOBID": "$drona_info_jobs",
          "NODE": "$drona_node"
        },
        "retriever": "drona_slurm_cgroups.sh",
        "layout": { "preset": "card", "title": "System Monitor · Job $drona_info_jobs" },
        "refreshInterval": "120",
        "showRefreshButton": false,
        "allowHtml": true
      }
    }
  }
}
