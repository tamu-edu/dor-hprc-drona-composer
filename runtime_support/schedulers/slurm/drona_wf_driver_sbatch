#!/bin/bash
# Usage: drona_wf_driver_sbatch <job_file1> [job_file2] ... [job_fileN]
#
# A job file may name its stage with a line "#DRONA label: <text>" (e.g.
# "#DRONA label: MSA (CPU)"). The label is stored with the job id in
# runtime_meta.jobinfo and shown by the job scope picker ("MSA (CPU) · Job 123").

# 1. Check for at least one job file
if [ "$#" -lt 1 ]; then
    echo "Usage: drona_wf_driver_sbatch <job_file1> [job_file2...]"
    exit 1
fi

JOB_FILES=("$@")
PREV_JOBID=""
ALL_JOBIDS=()
ALL_LABELS=()

# 2. Iterate over the job files to build the pipeline
for JOB_FILE in "${JOB_FILES[@]}"; do
    if [ -z "$PREV_JOBID" ]; then
        # First job: submit normally
        SUBMIT_OUTPUT=$(/sw/local/bin/sbatch "$JOB_FILE")
    else
        # Subsequent jobs: submit with dependency on the previous job
        SUBMIT_OUTPUT=$(/sw/local/bin/sbatch --dependency=afterok:"$PREV_JOBID" "$JOB_FILE")
    fi

    # Extract Job ID
    CURRENT_ID=$(echo "$SUBMIT_OUTPUT" | sed -n 's/.*Submitted batch job \([0-9]\+\).*/\1/p')

    if [ -z "$CURRENT_ID" ]; then
        echo "Error: Failed to submit $JOB_FILE"
        exit 1
    fi

    ALL_JOBIDS+=("$CURRENT_ID")
    ALL_LABELS+=("$(sed -n 's/^#DRONA[[:space:]]\+label:[[:space:]]*//p' "$JOB_FILE" | head -n 1 | sed 's/[[:space:]]*$//')")
    PREV_JOBID="$CURRENT_ID"
done

# 3. Record the jobs in the workflow's runtime_meta.jobinfo: [{"id": N}, {"id": N, "label": "..."}]
#    A new workflow's list is replaced. In a run on an existing workflow (DRONA_RUN_DIR is
#    set, e.g. a Manage action) DRONA_WF_ID is that workflow, so the jobs are appended to
#    its list instead. Other runtime_meta keys are kept in both cases.
python3 - "${ALL_JOBIDS[@]}" "${ALL_LABELS[@]}" <<'PYEOF'
import json, os, sys
sys.path.insert(0, os.path.join(os.environ.get("DRONA_RUNTIME_DIR", ""), "db_access"))
import drona_db_retriever as db

n = (len(sys.argv) - 1) // 2
ids, labels = sys.argv[1:1 + n], sys.argv[1 + n:]
jobs = []
for job_id, label in zip(ids, labels):
    job = {"id": int(job_id)}
    if label:
        job["label"] = label
    jobs.append(job)

wf_id = os.environ.get("DRONA_WF_ID", "")
record = db.get_record(wf_id) if wf_id else None
if record is None:
    sys.exit(0)
try:
    meta = json.loads(record.get("runtime_meta") or "{}")
except ValueError:
    meta = {}
if not isinstance(meta, dict):
    meta = {}
if os.environ.get("DRONA_RUN_DIR"):
    old = [j for j in (meta.get("jobinfo") or []) if isinstance(j, dict)]
    known = {str(j.get("id")) for j in old}
    jobs = old + [j for j in jobs if str(j["id"]) not in known]
meta["jobinfo"] = jobs
db.update_record(wf_id, runtime_meta=json.dumps(meta))
PYEOF

# 5. Formatted Output
if [ "${#ALL_JOBIDS[@]}" -eq 1 ]; then
    # Single Job Output
    echo "Job submitted successfully: ID ${ALL_JOBIDS[0]}"
else
    # Pipeline Output
    echo "Pipeline submitted successfully:"
    for i in "${!ALL_JOBIDS[@]}"; do
        if [ "$i" -eq 0 ]; then
            echo "  [Start] ➔ Job ID: ${ALL_JOBIDS[$i]}"
        else
            echo "      └─➔ Job ID: ${ALL_JOBIDS[$i]} (depends on ${ALL_JOBIDS[$((i-1))]})"
        fi
    done
fi
echo "" # New line at the end
